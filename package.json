{
	"name": "ender-launcher",
	"version": "0.1.0",
	"type": "module",
	"bin": {
		"ender": "./index.js"
	},
	"exports": {
		"./package.json": "./package.json",
		".": "./index.js"
	},
	"description": "Minecraft instances, mods and servers from the command line",
	"author": "fatlard1993",
	"license": "MIT",
	"scripts": {
		"start": "bun index.js",
		"test": "bun test",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"compile": "bun build --compile index.js --outfile ender",
		"version": "npm version"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fatlard1993/ender-launcher.git"
	},
	"bugs": {
		"url": "https://github.com/fatlard1993/ender-launcher/issues"
	},
	"homepage": "https://github.com/fatlard1993/ender-launcher#readme",
	"dependencies": {
		"log": "github:fatlard1993/log#e4cb364",
		"qrcode-terminal": "^0.12.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.39.5",
		"@vanilla-bean/components": "^2.0.1",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^50.8.0",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-unicorn": "^58.0.0",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^16.5.0",
		"prettier": "3.5.3"
	},
	"engines": {
		"bun": ">=1.4.0"
	}
}
