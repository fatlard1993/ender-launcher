{
	"name": "ender-launcher",
	"version": "0.1.2",
	"type": "module",
	"bin": {
		"ender": "./index.js"
	},
	"exports": {
		"./package.json": "./package.json",
		".": "./index.js",
		"./archive": "./src/archive.js",
		"./enderPack": "./src/instance/enderPack.js",
		"./metadata": "./src/mods/metadata.js",
		"./packwiz": "./src/instance/packwiz.js",
		"./scan": "./src/mods/capabilities.js",
		"./range": "./src/mods/range.js",
		"./rank": "./src/mods/rank.js",
		"./spec": "./src/mods/spec.js",
		"./support": "./src/mods/support.js",
		"./web": "./src/commands/web.js"
	},
	"description": "Minecraft instances, mods and servers from the command line",
	"author": "fatlard1993",
	"license": "MIT",
	"scripts": {
		"prepare": "bun run prepare:githooks",
		"prepare:githooks": "[ -n \"$CI\" ] && exit 0 || (git config --local core.hooksPath .githooks || echo 'Cannot set core.hooksPath -- push checks will not run')",
		"start": "bun index.js",
		"test": "bun test",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"compile": "bun build --compile index.js --outfile ender",
		"version": "bun pm version"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fatlard1993/ender-launcher.git"
	},
	"bugs": {
		"url": "https://github.com/fatlard1993/ender-launcher/issues"
	},
	"homepage": "https://github.com/fatlard1993/ender-launcher#readme",
	"dependencies": {
		"log": "github:fatlard1993/log#e4cb364",
		"qrcode-terminal": "^0.12.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@vanilla-bean/components": "^7.0.2",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.7.0",
		"prettier": "3.5.3"
	},
	"engines": {
		"bun": ">=1.4.0"
	}
}
